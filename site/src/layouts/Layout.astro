---
import { getAllDocs } from '../utils/knowledge';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = "Chishiki · Knowledge Base", description = "A minimalist Japanese-inspired knowledge repository." } = Astro.props;

const docs = getAllDocs();

// Group docs by category
const categories = docs.reduce((acc, doc) => {
  if (!acc[doc.category]) {
    acc[doc.category] = [];
  }
  acc[doc.category].push(doc);
  return acc;
}, {});
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- Google Fonts: Noto Serif JP & Inter for clean typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Noto+Serif+JP:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body class="h-full flex flex-col md:flex-row antialiased bg-paper text-charcoal selection:bg-[#e8e4de] selection:text-[#111]">

  <!-- Mobile Header -->
  <header class="md:hidden flex items-center justify-between px-6 py-4 bg-paper border-b border-border sticky top-0 z-30">
    <a href="/" class="text-lg font-serif tracking-widest text-charcoal">知 · Chishiki</a>
    <button id="menu-toggle" aria-label="Toggle Menu" class="p-2 text-muted hover:text-charcoal">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </header>

  <!-- Sidebar Navigation -->
  <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-80 bg-[#f4f1ea] border-r border-border flex flex-col transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out">
    <!-- Sidebar Header -->
    <div class="px-6 py-6 border-b border-border flex items-center justify-between">
      <div>
        <a href="/" class="text-xl font-serif tracking-widest text-charcoal hover:opacity-80 transition-opacity">
          知 <span class="text-xs uppercase tracking-widest text-muted ml-2 font-sans">Chishiki</span>
        </a>
        <p class="text-xs text-muted mt-1 tracking-wide">静寂と知恵の空間 — Wabi-Sabi</p>
      </div>
      <button id="menu-close" class="md:hidden text-muted hover:text-charcoal">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Search Box -->
    <div class="p-4 border-b border-border">
      <div class="relative">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-muted">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </span>
        <input 
          type="text" 
          id="search-input" 
          placeholder="Search knowledge..." 
          class="w-full pl-9 pr-4 py-2 text-xs bg-washi border border-border rounded focus:outline-none focus:border-muted text-charcoal placeholder-[#999] transition-colors"
        />
      </div>
    </div>

    <!-- Navigation Links -->
    <nav class="flex-1 overflow-y-auto px-4 py-4 space-y-6">
      <div id="search-results" class="hidden space-y-1">
        <p class="text-[10px] font-semibold tracking-widest uppercase text-muted px-2 mb-2">Search Results</p>
        <div id="results-container"></div>
      </div>

      <div id="nav-categories" class="space-y-6">
        {Object.entries(categories).map(([cat, items]) => (
          <div>
            <h3 class="text-[11px] font-semibold tracking-widest uppercase text-muted px-2 mb-2 font-mono">
              {cat}
            </h3>
            <ul class="space-y-0.5">
              {items.map(doc => (
                <li>
                  <a 
                    href={`/doc/${doc.slug}`}
                    class="block px-2 py-1.5 text-xs text-[#444] hover:text-charcoal hover:bg-[#eae5dd] rounded transition-colors truncate"
                    title={doc.title}
                  >
                    {doc.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>

    <!-- Sidebar Footer -->
    <div class="p-4 border-t border-border text-[11px] text-muted flex justify-between items-center">
      <span>{docs.length} knowledge items</span>
      <a href="https://github.com" target="_blank" rel="noreferrer" class="hover:text-charcoal transition-colors">GitHub</a>
    </div>
  </aside>

  <!-- Main Content Wrapper -->
  <div class="flex-1 md:pl-80 flex flex-col min-h-full">
    <main class="flex-1 px-6 md:px-16 py-10 max-w-4xl w-full mx-auto">
      <slot />
    </main>
    
    <!-- Footer -->
    <footer class="py-8 px-6 text-center text-xs text-muted border-t border-border">
      <p class="font-serif">知 — Chishiki Knowledge Repository · Built with Wabi-Sabi serenity</p>
    </footer>
  </div>

  <!-- Client-side Search Script -->
  <script define:vars={{ docs }}>
    const searchInput = document.getElementById('search-input');
    const searchResults = document.getElementById('search-results');
    const resultsContainer = document.getElementById('results-container');
    const navCategories = document.getElementById('nav-categories');
    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const sidebar = document.getElementById('sidebar');

    // Mobile menu toggle
    menuToggle?.addEventListener('click', () => {
      sidebar.classList.toggle('-translate-x-full');
    });
    menuClose?.addEventListener('click', () => {
      sidebar.classList.add('-translate-x-full');
    });

    // Search logic
    searchInput?.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      if (!query) {
        searchResults.classList.add('hidden');
        navCategories.classList.remove('hidden');
        return;
      }

      navCategories.classList.add('hidden');
      searchResults.classList.remove('hidden');

      const matches = docs.filter(d => 
        d.title.toLowerCase().includes(query) || 
        d.slug.toLowerCase().includes(query) ||
        d.content.toLowerCase().includes(query)
      ).slice(0, 15);

      if (matches.length === 0) {
        resultsContainer.innerHTML = '<p class="px-2 py-2 text-xs text-muted">No matching thoughts found.</p>';
        return;
      }

      resultsContainer.innerHTML = matches.map(m => `
        <a href="/doc/${m.slug}" class="block px-2 py-2 text-xs text-[#444] hover:text-charcoal hover:bg-[#eae5dd] rounded transition-colors">
          <div class="font-medium text-charcoal truncate">${m.title}</div>
          <div class="text-[10px] text-muted truncate">${m.slug}</div>
        </a>
      `).join('');
    });
  </script>
</body>
</html>
