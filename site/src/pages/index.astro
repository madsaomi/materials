---
import Layout from '../layouts/Layout.astro';
import { getAllDocs } from '../utils/knowledge';

const docs = getAllDocs();

const categories = docs.reduce((acc, doc) => {
  if (!acc[doc.category]) {
    acc[doc.category] = [];
  }
  acc[doc.category].push(doc);
  return acc;
}, {});

const categoryCount = Object.keys(categories).length;
---

<Layout title="知 · Chishiki Knowledge Base">
  <div class="space-y-12">
    <!-- Hero Section -->
    <section class="space-y-4 border-b border-[#e8e4de] pb-10">
      <div class="inline-block px-3 py-1 bg-[#eae5dd] text-[#555] text-[11px] tracking-widest uppercase font-mono rounded">
        Knowledge Repository
      </div>
      <h1 class="text-3xl md:text-5xl font-serif text-[#2b2b2b] tracking-tight font-light">
        知恵の庭
      </h1>
      <p class="text-base text-[#555] max-w-2xl leading-relaxed">
        A tranquil sanctuary for structured thought, language acquisition, mnemonics, and programming craft. Designed with Wabi-Sabi simplicity and effortless navigation.
      </p>
    </section>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
      <div class="washi-card p-6 rounded shadow-sm">
        <div class="text-2xl font-serif text-[#2b2b2b]">{docs.length}</div>
        <div class="text-xs text-[#777] mt-1 tracking-wide uppercase font-mono">Total Documents</div>
      </div>
      <div class="washi-card p-6 rounded shadow-sm">
        <div class="text-2xl font-serif text-[#2b2b2b]">{categoryCount}</div>
        <div class="text-xs text-[#777] mt-1 tracking-wide uppercase font-mono">Core Domains</div>
      </div>
      <div class="washi-card p-6 rounded shadow-sm col-span-2 md:col-span-1">
        <div class="text-2xl font-serif text-[#2b2b2b]">靜寂</div>
        <div class="text-xs text-[#777] mt-1 tracking-wide uppercase font-mono">Serenity & Focus</div>
      </div>
    </div>

    <!-- Categories Directory -->
    <section class="space-y-6">
      <h2 class="text-xl font-serif text-[#2b2b2b]">Domains of Study</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {Object.entries(categories).map(([cat, items]) => (
          <div class="washi-card p-6 rounded shadow-sm hover:border-[#ccc] transition-colors flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono tracking-widest uppercase text-[#777]">{cat}</span>
                <span class="text-xs text-[#999] bg-[#f7f5f0] px-2 py-0.5 rounded">{items.length} docs</span>
              </div>
              <h3 class="text-lg font-serif text-[#2b2b2b] capitalize">{cat}</h3>
              <ul class="space-y-1 pt-2 border-t border-[#f0ece6]">
                {items.slice(0, 4).map(doc => (
                  <li>
                    <a href={`/doc/${doc.slug}`} class="text-xs text-[#555] hover:text-[#111] hover:underline truncate block py-0.5">
                      {doc.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="pt-4 mt-4 border-t border-[#f0ece6] flex justify-end">
              <a href={`/doc/${items[0].slug}`} class="text-xs text-[#333] font-medium hover:opacity-75 transition-opacity inline-flex items-center gap-1">
                Explore {cat} <span>&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
