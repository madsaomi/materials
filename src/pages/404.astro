---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found · Chishiki">
  <div class="text-center py-20 space-y-6">
    <h1 class="text-6xl font-serif text-[#2b2b2b] dark:text-[#e8e4de] font-light">404</h1>
    <p class="text-base text-[#666] dark:text-[#aaa]">The requested knowledge could not be found in this garden.</p>
    <div>
      <a href="/" class="inline-block px-6 py-2 bg-[#eae5dd] dark:bg-[#252525] text-[#333] dark:text-[#e8e4de] text-xs tracking-wider uppercase rounded hover:bg-[#d8d2c8] dark:hover:bg-[#333] transition-colors font-mono">
        Return Home
      </a>
    </div>
  </div>
</Layout>
