---
import Layout from '../../layouts/Layout.astro';
import { getAllDocs, getDocBySlug } from '../../utils/knowledge';

export function getStaticPaths() {
  const docs = getAllDocs();
  return docs.map(doc => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { slug } = Astro.params;
const { doc } = Astro.props;
const currentDoc = doc || getDocBySlug(slug);

if (!currentDoc) {
  return Astro.redirect('/404');
}

const pathSegments = currentDoc.slug.split('/');
const allDocs = getAllDocs();
const breadcrumbs = pathSegments.map((segment, index) => {
  const partialSlug = pathSegments.slice(0, index + 1).join('/');
  let title = segment.replace(/-/g, ' ');
  title = title.charAt(0).toUpperCase() + title.slice(1);
  
  let url = `/doc/${partialSlug}`;
  const exactDoc = allDocs.find(d => d.slug === partialSlug);
  const indexDoc = allDocs.find(d => d.slug === `${partialSlug}/index`);
  
  if (exactDoc) {
    url = `/doc/${exactDoc.slug}`;
    title = exactDoc.title;
  } else if (indexDoc) {
    url = `/doc/${indexDoc.slug}`;
    title = indexDoc.title;
  }
  
  return {
    title,
    url,
    isLast: index === pathSegments.length - 1
  };
});
---

<Layout title={`${currentDoc.title} · Chishiki`}>
  <div class="xl:flex xl:gap-12 xl:items-start max-w-6xl mx-auto w-full">
    <article class="space-y-8 flex-1 min-w-0">
      <!-- Breadcrumb / Meta -->
      <nav aria-label="Breadcrumb" class="flex items-center space-x-2 text-xs text-[#777] dark:text-[#888] font-mono overflow-x-auto py-1">
        <a href="/" class="hover:text-[#111] dark:hover:text-[#fff] transition-colors">Home</a>
        <span>/</span>
        {breadcrumbs.map((crumb, idx) => (
          <>
            {idx > 0 && <span>/</span>}
            {crumb.isLast ? (
              <span class="truncate text-[#333] dark:text-[#e8e4de]" title={crumb.title}>{crumb.title}</span>
            ) : (
              <a href={crumb.url} class="hover:text-[#111] dark:hover:text-[#fff] transition-colors truncate" title={crumb.title}>{crumb.title}</a>
            )}
          </>
        ))}
      </nav>

      <!-- Document Header -->
      <header class="space-y-3 border-b border-[#e8e4de] dark:border-[#333] pb-6">
        <h1 class="text-3xl md:text-4xl font-serif text-[#2b2b2b] dark:text-[#e8e4de] font-light leading-tight">
          {currentDoc.title}
        </h1>
        <div class="text-xs text-[#888] font-mono">
          Path: {currentDoc.relativePath}
        </div>
      </header>

      <!-- Document Content Rendered HTML -->
      <div class="prose max-w-none text-[#333] dark:text-[#ccc] leading-relaxed space-y-4 text-sm md:text-base overflow-x-auto">
        <Fragment set:html={currentDoc.html} />
      </div>

      <!-- Navigation Footer -->
      <div class="pt-10 border-t border-[#e8e4de] dark:border-[#333] flex justify-between items-center text-xs text-[#666]">
        <a href="/" class="hover:text-[#111] dark:hover:text-[#fff]">&larr; Return to Garden</a>
        <a href="#" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;" class="hover:text-[#111] dark:hover:text-[#fff]">Back to top &uarr;</a>
      </div>
    </article>

    <!-- Table of Contents Sidebar (Desktop) -->
    {currentDoc.toc && currentDoc.toc.length > 0 && (
      <aside class="hidden xl:block w-64 shrink-0 order-last">
        <div class="sticky top-24 space-y-3 bg-[#f4f1ea] dark:bg-[#1e1e1e] p-4 rounded-lg border border-[#e8e4de] dark:border-[#333] max-h-[calc(100vh-8rem)] overflow-y-auto">
          <h3 class="text-xs font-semibold tracking-widest uppercase text-muted dark:text-[#888] font-mono">
            Table of Contents
          </h3>
          <nav class="space-y-1 text-xs">
            {currentDoc.toc.map(heading => (
              <a 
                href={`#${heading.id}`}
                class={`block py-1 text-[#555] dark:text-[#aaa] hover:text-charcoal dark:hover:text-[#fff] transition-colors truncate ${heading.level === 3 ? 'pl-3 text-[11px]' : 'font-medium'}`}
                title={heading.text}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </div>
      </aside>
    )}
  </div>

  <style is:global>
    article h1 { font-size: 2rem; font-weight: 300; font-family: 'Noto Serif JP', serif; margin-top: 2rem; margin-bottom: 1rem; color: #2b2b2b; scroll-margin-top: 5rem; }
    .dark article h1 { color: #e8e4de; }
    article h2 { font-size: 1.5rem; font-weight: 400; font-family: 'Noto Serif JP', serif; margin-top: 1.75rem; margin-bottom: 0.75rem; color: #2b2b2b; border-bottom: 1px solid #eee; padding-bottom: 0.25rem; scroll-margin-top: 5rem; }
    .dark article h2 { color: #e8e4de; border-color: #333; }
    article h3 { font-size: 1.25rem; font-weight: 500; margin-top: 1.5rem; margin-bottom: 0.5rem; color: #333; scroll-margin-top: 5rem; }
    .dark article h3 { color: #ccc; }
    article p { margin-bottom: 1.25rem; line-height: 1.8; color: #3b3b3b; }
    .dark article p { color: #bbb; }
    article ul { list-style-type: disc; padding-left: 1.5rem; margin-bottom: 1.25rem; }
    article ol { list-style-type: decimal; padding-left: 1.5rem; margin-bottom: 1.25rem; }
    article li { margin-bottom: 0.35rem; }
    article blockquote { border-left: 3px solid #d4cec4; padding-left: 1rem; margin: 1.5rem 0; font-style: italic; color: #555; background: #f4f1ea; padding-top: 0.5rem; padding-bottom: 0.5rem; border-radius: 0 4px 4px 0; }
    .dark article blockquote { border-color: #555; background: #252525; color: #aaa; }
    article code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.875em; background: #f0ece6; padding: 0.2rem 0.4rem; border-radius: 3px; color: #2b2b2b; }
    .dark article code { background: #2a2a2a; color: #e8e4de; }
    article pre { background: #1e1e1e; color: #d4d4d4; padding: 1rem; border-radius: 6px; overflow-x: auto; margin: 1.5rem 0; font-size: 0.875rem; position: relative; }
    article pre code { background: transparent; padding: 0; color: inherit; }
    article table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.875rem; display: block; overflow-x: auto; white-space: nowrap; }
    article th, article td { border: 1px solid #e8e4de; padding: 0.75rem; text-align: left; }
    .dark article th, .dark article td { border-color: #333; }
    article th { background: #f4f1ea; font-weight: 600; color: #2b2b2b; }
    .dark article th { background: #252525; color: #e8e4de; }
    article a { color: #2b2b2b; text-decoration: underline; text-underline-offset: 3px; }
    .dark article a { color: #e8e4de; }
    article a:hover { color: #000; }
    .dark article a:hover { color: #fff; }
  </style>
</Layout>
